+        void stage(size_t offset, const void* data, size_t size) {
+            std::memcpy(staging.data() + offset, data, size);
+            dirtyBegin = std::min(dirtyBegin, offset);
+            dirtyEnd = std::max(dirtyEnd, offset + size);
+        }
