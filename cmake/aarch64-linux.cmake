# Supply a target SDK; never silently link Homebrew/macOS or host Linux libraries.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(VECTORUNE_SYSROOT "" CACHE PATH "Target ARM64 sysroot")
set(VECTORUNE_TOOLCHAIN_PREFIX "aarch64-linux-gnu-" CACHE STRING "Cross compiler prefix, optionally absolute")
if(NOT IS_DIRECTORY "${VECTORUNE_SYSROOT}")
    message(FATAL_ERROR "Set VECTORUNE_SYSROOT to the target SDK sysroot")
endif()
set(CMAKE_SYSROOT "${VECTORUNE_SYSROOT}")
set(CMAKE_C_COMPILER "${VECTORUNE_TOOLCHAIN_PREFIX}gcc")
set(CMAKE_CXX_COMPILER "${VECTORUNE_TOOLCHAIN_PREFIX}g++")
set(CMAKE_FIND_ROOT_PATH "${VECTORUNE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES VECTORUNE_SYSROOT VECTORUNE_TOOLCHAIN_PREFIX)
